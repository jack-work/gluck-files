="2" height="1"/><rect x="3" y="7" width="2" height="1"/><rect x="4" y="8" width="1" height="1"/></symbol><symbol id="ic-down" viewBox="0 0 9 9" shape-rendering="crispEdges"><rect x="3" y="0" width="3" height="1"/><rect x="3" y="1" width="3" height="1"/><rect x="3" y="2" width="3" height="1"/><rect x="1" y="3" width="7" height="1"/><rect x="2" y="4" width="5" height="1"/><rect x="3" y="5" width="3" height="1"/><rect x="4" y="6" width="1" height="1"/><rect x="0" y="7" width="1" height="1"/><rect x="8" y="7" width="1" height="1"/><rect x="0" y="8" width="9" height="1"/></symbol><symbol id="ic-up" viewBox="0 0 9 9" shape-rendering="crispEdges"><rect x="4" y="0" width="1" height="1"/><rect x="3" y="1" width="3" height="1"/><rect x="2" y="2" width="5" height="1"/><rect x="1" y="3" width="7" height="1"/><rect x="3" y="4" width="3" height="1"/><rect x="3" y="5" width="3" height="1"/><rect x="3" y="6" width="3" height="1"/><rect x="0" y="7" width="1" height="1"/><rect x="8" y="7" width="1" height="1"/><rect x="0" y="8" width="9" height="1"/></symbol><symbol id="ic-close" viewBox="0 0 7 7" shape-rendering="crispEdges"><rect x="0" y="0" width="1" height="1"/><rect x="6" y="0" width="1" height="1"/><rect x="1" y="1" width="1" height="1"/><rect x="5" y="1" width="1" height="1"/><rect x="2" y="2" width="1" height="1"/><rect x="4" y="2" width="1" height="1"/><rect x="3" y="3" width="1" height="1"/><rect x="2" y="4" width="1" height="1"/><rect x="4" y="4" width="1" height="1"/><rect x="1" y="5" width="1" height="1"/><rect x="5" y="5" width="1" height="1"/><rect x="0" y="6" width="1" height="1"/><rect x="6" y="6" width="1" height="1"/></symbol><symbol id="ic-lock" viewBox="0 0 7 9" shape-rendering="crispEdges"><rect x="2" y="0" width="3" height="1"/><rect x="1" y="1" width="1" height="1"/><rect x="5" y="1" width="1" height="1"/><rect x="1" y="2" width="1" height="1"/><rect x="5" y="2" width="1" height="1"/><rect x="0" y="3" width="7" height="1"/><rect x="0" y="4" width="1" height="1"/><rect fill-opacity=".32" x="1" y="4" width="5" height="1"/><rect x="6" y="4" width="1" height="1"/><rect x="0" y="5" width="1" height="1"/><rect fill-opacity=".32" x="1" y="5" width="2" height="1"/><rect x="3" y="5" width="1" height="1"/><rect fill-opacity=".32" x="4" y="5" width="2" height="1"/><rect x="6" y="5" width="1" height="1"/><rect x="0" y="6" width="1" height="1"/><rect fill-opacity=".32" x="1" y="6" width="2" height="1"/><rect x="3" y="6" width="1" height="1"/><rect fill-opacity=".32" x="4" y="6" width="2" height="1"/><rect x="6" y="6" width="1" height="1"/><rect x="0" y="7" width="1" height="1"/><rect fill-opacity=".32" x="1" y="7" width="5" height="1"/><rect x="6" y="7" width="1" height="1"/><rect x="0" y="8" width="7" height="1"/></symbol><symbol id="ic-glass" viewBox="0 0 7 9" shape-rendering="crispEdges"><rect x="0" y="0" width="7" height="1"/><rect x="0" y="1" width="1" height="1"/><rect x="6" y="1" width="1" height="1"/><rect x="1" y="2" width="1" height="1"/><rect x="5" y="2" width="1" height="1"/><rect x="2" y="3" width="1" height="1"/><rect x="4" y="3" width="1" height="1"/><rect x="3" y="4" width="1" height="1"/><rect x="2" y="5" width="1" height="1"/><rect x="4" y="5" width="1" height="1"/><rect x="1" y="6" width="1" height="1"/><rect x="5" y="6" width="1" height="1"/><rect x="0" y="7" width="1" height="1"/><rect x="2" y="7" width="3" height="1"/><rect x="6" y="7" width="1" height="1"/><rect x="0" y="8" width="7" height="1"/></symbol><symbol id="ic-sun" viewBox="0 0 9 9" shape-rendering="crispEdges"><rect x="4" y="0" width="1" height="1"/><rect x="1" y="1" width="1" height="1"/><rect x="4" y="1" width="1" height="1"/><rect x="7" y="1" width="1" height="1"/><rect x="2" y="2" width="5" height="1"/><rect x="3" y="3" width="3" height="1"/><rect x="0" y="4" width="4" height="1"/><rect fill-opacity=".32" x="4" y="4" width="1" height="1"/><rect x="5" y="4" width="4" height="1"/><rect x="3" y="5" width="3" height="1"/><rect x="2" y="6" width="5" height="1"/><rect x="1" y="7" width="1" height="1"/><rect x="4" y="7" width="1" height="1"/><rect x="7" y="7" width="1" height="1"/><rect x="4" y="8" width="1" height="1"/></symbol><symbol id="ic-list" viewBox="0 0 9 8" shape-rendering="crispEdges"><rect x="0" y="0" width="2" height="1"/><rect x="3" y="0" width="6" height="1"/><rect x="0" y="1" width="2" height="1"/><rect x="3" y="1" width="6" height="1"/><rect x="0" y="3" width="2" height="1"/><rect x="3" y="3" width="6" height="1"/><rect x="0" y="4" width="2" height="1"/><rect x="3" y="4" width="6" height="1"/><rect x="0" y="6" width="2" height="1"/><rect x="3" y="6" width="6" height="1"/><rect x="0" y="7" width="2" height="1"/><rect x="3" y="7" width="6" height="1"/></symbol><symbol id="ic-grid" viewBox="0 0 7 7" shape-rendering="crispEdges"><rect x="0" y="0" width="3" height="1"/><rect x="4" y="0" width="3" height="1"/><rect x="0" y="1" width="3" height="1"/><rect x="4" y="1" width="3" height="1"/><rect x="0" y="2" width="3" height="1"/><rect x="4" y="2" width="3" height="1"/><rect x="0" y="4" width="3" height="1"/><rect x="4" y="4" width="3" height="1"/><rect x="0" y="5" width="3" height="1"/><rect x="4" y="5" width="3" height="1"/><rect x="0" y="6" width="3" height="1"/><rect x="4" y="6" width="3" height="1"/></symbol></defs></svg>
<header class="p-mast">
  <a class="p-mark" href="/">files</a>
  {% if upload_href %}<a class="p-btn" href="{{ upload_href }}"><svg class="ic" style="--w:9;--h:9;--px:2px" viewBox="0 0 9 9" aria-hidden="true"><use href="#ic-up"/></svg> Upload</a>{% endif %}
</header>

<main class="p-wrap">
  <nav class="p-crumbs" aria-label="Where you are">
    {% if not mine %}<a href="/">files</a>{% endif %}{% for c in crumbs %}{% if not (loop.first and mine) %}<span class="sep">/</span>{% endif %}{% if loop.last %}<span class="here">{{ c.name }}</span>{% else %}<a href="{{ c.href }}">{{ c.name }}</a>{% endif %}{% endfor %}
  </nav>

  <div class="p-title"><h1>{{ heading }}</h1><p>{{ tally }}</p></div>
  {% if is_home %}<p class="p-privacy">Only you can see these.</p>{% endif %}

  {% if select %}
  <div class="p-actions"><span class="p-title" style="padding:0"><p>Tap photos to pick up to {{ pick_cap }}.</p></span></div>
  {% elif save_href or select_href %}
  <div class="p-actions">
    {% if save_href %}<a class="p-btn" href="{{ save_href }}"><svg class="ic" style="--w:9;--h:9;--px:2px" viewBox="0 0 9 9" aria-hidden="true"><use href="#ic-down"/></svg> To iPhone</a>{% endif %}
    {% if select_href %}<a class="p-btn ghost" href="{{ select_href }}">Select</a>{% endif %}
  </div>
  {% endif %}

  {% if dirs %}
  <div class="p-cards">
    {% for d in dirs %}<a class="p-card" href="{{ d.href }}"><svg class="ic" style="--w:10;--h:8;--px:3px" viewBox="0 0 10 8" aria-hidden="true"><use href="#ic-folder"/></svg><b>{{ d.name }}</b></a>{% endfor %}
  </div>
  {% endif %}

  {% for day in days %}
  <div class="p-day"><span>{{ day.label }}</span><span class="n">{{ day.files|length }}</span>{% if day_href and not select %}<a class="save" href="{{ day_href(day.month) }}"><svg class="ic" style="--w:9;--h:9;--px:2px" viewBox="0 0 9 9" aria-hidden="true"><use href="#ic-down"/></svg> Save day</a>{% endif %}</div>
  <div class="p-grid">
    {% for f in day.files %}
    <div class="p-tile {{ f.kind }}{% if f.picked %} picked{% endif %}"><a href="{{ f.toggle if select else (f.viewer or f.href) }}">
      {% if f.kind == 'image' %}<img loading="lazy" decoding="async" src="{{ f.href }}" alt="{{ f.name }}">
      {% else %}<span class="glyph"><svg class="ic" style="--w:7;--h:9;--px:3px" viewBox="0 0 7 9" aria-hidden="true"><use href="#ic-play"/></svg>{{ f.name }}</span>{% endif %}
      {% if f.heic %}<span class="heic">HEIC</span>{% endif %}
      <span class="mark"><svg class="ic" style="--w:9;--h:7;--px:3px" viewBox="0 0 9 7" aria-hidden="true"><use href="#ic-check"/></svg></span>
    </a></div>
    {% endfor %}
  </div>
  {% endfor %}

  {% if other %}
  <div class="p-other">
    {% for f in other %}<a class="p-row" href="{{ f.viewer or f.href }}"><svg class="ic" style="--w:8;--h:10;--px:3px" viewBox="0 0 8 10" aria-hidden="true"><use href="#ic-pdf"/></svg><span class="nm">{{ f.name }}</span><span class="sz">{{ f.size }}</span></a>{% endfor %}
  </div>
  {% endif %}

  {% if not dirs and not files %}<div class="p-empty"><h2>Nothing here yet</h2><p>Photos and videos you upload show up here.</p>{% if upload_href %}<a class="p-btn" href="{{ upload_href }}"><svg class="ic" style="--w:9;--h:9;--px:2px" viewBox="0 0 9 9" aria-hidden="true"><use href="#ic-up"/></svg> Upload photos</a>{% endif %}</div>{% endif %}

  <p class="p-foot">{{ bucket }} on spain{% if truncated %} &middot; listing truncated at {{ shown }} entries{% endif %}</p>
</main>

{% if select %}
<div class="p-dock">
  <a class="p-btn ghost" href="{{ done_href }}">Done</a>
  {% if picks %}<a class="p-btn" href="{{ pick_href }}">Save {{ picks }} to iPhone</a><a class="p-btn ghost" href="{{ clear_href }}">Clear</a>
  {% else %}<span class="p-btn off">Pick some photos</span>{% endif %}
</div>
{% endif %}
</body>
</html>
