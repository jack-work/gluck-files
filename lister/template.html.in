" height="1"/><rect x="0" y="5" width="1" height="1"/><rect fill-opacity=".32" x="1" y="5" width="1" height="1"/><rect x="2" y="5" width="3" height="1"/><rect fill-opacity=".32" x="5" y="5" width="2" height="1"/><rect x="7" y="5" width="1" height="1"/><rect fill-opacity=".32" x="8" y="5" width="1" height="1"/><rect x="9" y="5" width="1" height="1"/><rect x="0" y="6" width="10" height="1"/></symbol><symbol id="ic-video" viewBox="0 0 10 8" shape-rendering="crispEdges"><rect x="0" y="0" width="10" height="1"/><rect x="0" y="1" width="1" height="1"/><rect fill-opacity=".32" x="1" y="1" width="1" height="1"/><rect x="2" y="1" width="1" height="1"/><rect fill-opacity=".32" x="3" y="1" width="6" height="1"/><rect x="9" y="1" width="1" height="1"/><rect x="0" y="2" width="1" height="1"/><rect fill-opacity=".32" x="1" y="2" width="1" height="1"/><rect x="2" y="2" width="2" height="1"/><rect fill-opacity=".32" x="4" y="2" width="5" height="1"/><rect x="9" y="2" width="1" height="1"/><rect x="0" y="3" width="1" height="1"/><rect fill-opacity=".32" x="1" y="3" width="1" height="1"/><rect x="2" y="3" width="3" height="1"/><rect fill-opacity=".32" x="5" y="3" width="4" height="1"/><rect x="9" y="3" width="1" height="1"/><rect x="0" y="4" width="1" height="1"/><rect fill-opacity=".32" x="1" y="4" width="1" height="1"/><rect x="2" y="4" width="2" height="1"/><rect fill-opacity=".32" x="4" y="4" width="5" height="1"/><rect x="9" y="4" width="1" height="1"/><rect x="0" y="5" width="1" height="1"/><rect fill-opacity=".32" x="1" y="5" width="1" height="1"/><rect x="2" y="5" width="1" height="1"/><rect fill-opacity=".32" x="3" y="5" width="6" height="1"/><rect x="9" y="5" width="1" height="1"/><rect x="0" y="6" width="1" height="1"/><rect fill-opacity=".32" x="1" y="6" width="8" height="1"/><rect x="9" y="6" width="1" height="1"/><rect x="0" y="7" width="10" height="1"/></symbol><symbol id="ic-pdf" viewBox="0 0 8 10" shape-rendering="crispEdges"><rect x="0" y="0" width="5" height="1"/><rect x="0" y="1" width="1" height="1"/><rect fill-opacity=".32" x="1" y="1" width="4" height="1"/><rect x="5" y="1" width="2" height="1"/><rect x="0" y="2" width="1" height="1"/><rect fill-opacity=".32" x="1" y="2" width="4" height="1"/><rect x="5" y="2" width="1" height="1"/><rect fill-opacity=".32" x="6" y="2" width="1" height="1"/><rect x="7" y="2" width="1" height="1"/><rect x="0" y="3" width="1" height="1"/><rect fill-opacity=".32" x="1" y="3" width="4" height="1"/><rect x="5" y="3" width="3" height="1"/><rect x="0" y="4" width="1" height="1"/><rect fill-opacity=".32" x="1" y="4" width="6" height="1"/><rect x="7" y="4" width="1" height="1"/><rect x="0" y="5" width="1" height="1"/><rect fill-opacity=".32" x="1" y="5" width="1" height="1"/><rect x="2" y="5" width="4" height="1"/><rect fill-opacity=".32" x="6" y="5" width="1" height="1"/><rect x="7" y="5" width="1" height="1"/><rect x="0" y="6" width="1" height="1"/><rect fill-opacity=".32" x="1" y="6" width="6" height="1"/><rect x="7" y="6" width="1" height="1"/><rect x="0" y="7" width="1" height="1"/><rect fill-opacity=".32" x="1" y="7" width="1" height="1"/><rect x="2" y="7" width="4" height="1"/><rect fill-opacity=".32" x="6" y="7" width="1" height="1"/><rect x="7" y="7" width="1" height="1"/><rect x="0" y="8" width="1" height="1"/><rect fill-opacity=".32" x="1" y="8" width="6" height="1"/><rect x="7" y="8" width="1" height="1"/><rect x="0" y="9" width="8" height="1"/></symbol><symbol id="ic-check" viewBox="0 0 9 7" shape-rendering="crispEdges"><rect x="8" y="0" width="1" height="1"/><rect x="7" y="1" width="2" height="1"/><rect x="0" y="2" width="1" height="1"/><rect x="6" y="2" width="2" height="1"/><rect x="0" y="3" width="2" height="1"/><rect x="5" y="3" width="2" height="1"/><rect x="1" y="4" width="2" height="1"/><rect x="4" y="4" width="2" height="1"/><rect x="2" y="5" width="3" height="1"/><rect x="3" y="6" width="1" height="1"/></symbol><symbol id="ic-warn" viewBox="0 0 9 9" shape-rendering="crispEdge