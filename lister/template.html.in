<!DOCTYPE html>
<html lang="en"{% if scheme %} data-scheme="{{ scheme }}"{% endif %}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>{{ title }}</title>
<!-- zanni:fontpack -->
<!-- zanni:gesso -->
<style>
  :root { color-scheme: dark; --tile: #0e0708; }
  :root[data-scheme=light] { color-scheme: light; --tile: #cdb7a3; }
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; font-family: var(--fontpack-prose); font-size: 19px; line-height: 1.4; min-height: 100vh; -webkit-text-size-adjust: 100%; }
  a { color: var(--z-accent); }
  .ic { display: inline-block; width: calc(var(--w) * var(--px)); height: calc(var(--h) * var(--px)); fill: currentColor; flex: none; vertical-align: middle; }
  .p-mast { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 14px; border-bottom: 3px solid var(--gold); background: var(--z-ground-2); }
  .p-mark { font: 30px/1 var(--fontpack-display); letter-spacing: .06em; color: var(--z-ink); text-decoration: none; }
  .p-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 4px 14px 2px; border: 3px solid var(--z-ink); background: var(--z-accent); color: var(--z-on-accent); font: 21px/1 var(--fontpack-mono); letter-spacing: .08em; text-decoration: none; }
  .p-btn.ghost { background: transparent; color: var(--z-ink); }
  .p-btn:focus-visible, .p-tile a:focus-visible, .p-card:focus-visible { outline: 3px dotted var(--z-focus); outline-offset: 3px; }
  .p-wrap { max-width: 1280px; margin: 0 auto; padding: 0 0 120px; }
  .p-crumbs { display: flex; flex-wrap: wrap; gap: 2px 0; padding: 12px 14px 0; font: 20px/1.3 var(--fontpack-mono); letter-spacing: .06em; word-break: break-all; }
  .p-crumbs a { color: var(--z-accent); text-decoration: none; padding: 6px 0; }
  .p-crumbs .sep { margin: 0 7px; color: var(--gold); }
  .p-crumbs .here { padding: 6px 0; }
  .p-title { padding: 14px 14px 6px; }
  .p-title h1 { margin: 0; font: 400 40px/1.05 var(--fontpack-display); letter-spacing: .04em; word-break: break-word; }
  .p-title p { margin: 4px 0 0; color: var(--z-muted); font: 19px/1.3 var(--fontpack-mono); }
  .p-privacy { margin: 0 14px; font: 19px/1.3 var(--fontpack-mono); color: var(--z-muted); }
  .p-actions { display: flex; flex-wrap: wrap; gap: 8px; padding: 10px 14px 0; }
  .p-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 14px; }
  .p-card { display: grid; justify-items: start; gap: 10px; padding: 14px 12px 12px; border: 3px solid var(--gold); background: var(--z-ground-2); color: var(--z-ink); text-decoration: none; }
  .p-card .ic { color: var(--gold-bright); --px: 6px; }
  .p-card b { font: 400 22px/1.1 var(--fontpack-mono); letter-spacing: .05em; word-break: break-word; }
  .p-day { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; gap: 10px; padding: 12px 14px 6px; background: var(--z-ground); font: 22px/1 var(--fontpack-mono); letter-spacing: .06em; }
  .p-day .n { font-size: 19px; color: var(--z-muted); }
  .p-day .save { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 0 10px; border: 2px solid var(--gold-bright); color: var(--gold-bright); text-decoration: none; font-size: 19px; }
  .p-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px; padding: 3px 3px 0; }
  .p-tile { position: relative; aspect-ratio: 1; overflow: hidden; background: var(--tile); color: #f0dfc8; }
  .p-tile > a { position: absolute; inset: 0; display: block; color: inherit; text-decoration: none; }
  .p-tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; font: 16px/1.2 var(--fontpack-mono); color: #a5887b; word-break: break-all; padding: 4px; }
  .p-tile .glyph { position: absolute; inset: 0; display: grid; place-items: center; align-content: center; gap: 6px; padding: 6px; text-align: center; font: 16px/1.15 var(--fontpack-mono); color: var(--z-ink); word-break: break-all; }
  .p-tile .glyph .ic { color: var(--gold-bright); --px: 4px; }
  .p-tile.video { background: #1a0d0f; }
  .p-tile .tag { position: absolute; left: 4px; bottom: 4px; padding: 0 4px; background: rgba(14,7,8,.86); font: 16px/1.1 var(--fontpack-mono); letter-spacing: .04em; color: #f0dfc8; }
  .p-tile .heic { position: absolute; right: 4px; top: 4px; padding: 0 4px; background: rgba(14,7,8,.86); color: var(--gold-bright); font: 15px/1.15 var(--fontpack-mono); letter-spacing: .06em; }
  .p-tile .mark { position: absolute; right: 6px; bottom: 6px; display: none; place-items: center; width: 30px; height: 30px; background: var(--gold-bright); color: #1a0d0f; }
  .p-tile.picked { outline: 4px solid var(--gold-bright); outline-offset: -4px; }
  .p-tile.picked .mark { display: grid; }
  .p-tile.picked img { opacity: .7; }
  .p-other { padding: 10px 14px 0; display: grid; gap: 6px; }
  .p-row { display: grid; grid-template-columns: 40px 1fr auto; gap: 12px; align-items: center; min-height: 56px; padding: 6px 10px; border: 2px solid var(--z-line); background: var(--z-ground-2); color: var(--z-ink); text-decoration: none; }
  .p-row .ic { color: var(--gold-bright); --px: 3px; }
  .p-row .nm { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .p-row .sz { font: 17px/1 var(--fontpack-mono); color: var(--z-muted); }
  .p-empty { padding: 34px 18px; text-align: center; color: var(--z-muted); }
  .p-empty h2 { margin: 0 0 6px; font: 400 32px/1.1 var(--fontpack-display); color: var(--z-ink); }
  .p-dock { position: fixed; z-index: 50; left: 10px; right: 10px; bottom: calc(10px + env(safe-area-inset-bottom)); display: flex; gap: 8px; padding: 8px; border: 3px solid var(--gold); background: var(--z-ground); }
  .p-dock .p-btn { flex: 1; min-height: 52px; font-size: 23px; }
  .p-dock .ghost { flex: none; }
  .p-dock .off { opacity: .5; pointer-events: none; }
  .p-foot { margin: 18px 14px 0; font: 17px/1.3 var(--fontpack-mono); color: var(--z-muted); }
  @media (min-width: 900px) {
    .p-mast { padding: 10px 28px; }
    .p-wrap { padding: 0 28px 120px; }
    .p-crumbs, .p-title, .p-privacy, .p-actions, .p-other, .p-foot { padding-left: 0; padding-right: 0; margin-left: 0; margin-right: 0; }
    .p-day { padding-left: 0; }
    .p-cards { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); padding: 14px 0; }
    .p-grid { grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); padding: 3px 0 0; }
    .p-dock { left: 50%; right: auto; translate: -50% 0; width: min(560px, 90vw); }
  }
</style>
</head>
<body class="gesso">
